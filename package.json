{
  "name": "ibcm_flow",
  "version": "0.1.0",
  "description": "投行合规管理流程",
  "dependencies": {
    "@alifd/next": "^1.x",
    "@alifd/theme-design-pro": "^0.x",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@icedesign/container": "^1.0.4",
    "@types/react": "^16.9.20",
    "@types/react-dom": "^16.9.5",
    "antd": "^3.26.19",
    "antd-theme-generator": "^1.1.6",
    "babel-plugin-import": "^1.13.3",
    "build-plugin-antd": "^0.1.1",
    "lay-excel": "^1.8.3",
    "less": "^3.11.1",
    "lodash": "^4.17.21",
    "moment": "^2.24.0",
    "nanoid": "^3.1.23",
    "path-to-regexp": "^2.2.0",
    "pinyin-pro": "^3.26.0",
    "react": "^16.6.0",
    "react-app-rewire-less": "^2.1.3",
    "react-app-rewired": "^2.1.8",
    "react-document-title": "^2.0.3",
    "react-dom": "^16.6.0",
    "react-resizable": "^1.11.1",
    "react-draggable": "4.4.5",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "build-plugin-fusion": "^0.1.0",
    "build-plugin-icestark": "^2.0.0",
    "build-plugin-moment-locales": "^0.1.0",
    "form-data": "^4.0.0",
    "ice.js": "^1.0.0",
    "node-fetch": "^2.7.0",
    "prompts": "^2.4.2",
    "sass": "^1.32.13"
  },
  "eslintConfig": {
    "extends": "react-app",
    "ignorePatterns": "gtjaLinkWeb",
    "rules": {
      "no-undef": "off",
      "no-restricted-globals": "off",
      "no-unused-vars": "off"
    }
  },
  "scripts": {
    "start": "icejs start",
    "build": "icejs build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:upload": "node scripts/deploy.mjs --upload-only",
    "lint": "npm run eslint && npm run stylelint",
    "eslint": "eslint --cache --ext .js,.jsx,.ts,.tsx ./",
    "eslint:fix": "npm run eslint -- --fix",
    "stylelint": "stylelint \"**/*.{css,scss,less}\""
  },
  "private": true,
  "originTemplate": "@icedesign/stark-child-scaffold",
  "babel": {
    "plugins": [
      [
        "import",
        {
          "libraryName": "antd",
          "style": "less"
        }
      ],
      "@babel/plugin-transform-runtime"
    ]
  }
}
