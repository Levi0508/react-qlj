{
  "plugins": [
    [
      "build-plugin-icestark",
      {
        "umd": true
      }
    ],
    [
      "build-plugin-antd",
      {
        "themeConfig": {
          "primary-color": "#0962c1"
        }
      }
    ],
    [
      "build-plugin-fusion",
      {
        "themePackage": "@alifd/theme-design-pro"
      }
    ],
    [
      "build-plugin-moment-locales",
      {
        "locales": [
          "zh-cn"
        ]
      }
    ]
  ],
  "lessLoaderOptions": {
    "lessOptions": {
      "strictMath": true
    }
  },
  // 本地开发使用，打包部署到nginx后无用
